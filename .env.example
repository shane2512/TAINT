# Copy this file to .env and fill it in. .env is git-ignored. NEVER commit it, paste it, or share it.
# Everything here is TESTNET. Use brand-new throwaway accounts; never reuse a key from an account that holds real money.
# Nothing here is needed for the offline MOCK mode. See docs/SETUP-ACCOUNTS.md.

# Offline mode. Remove this line (or set it to 0) for live runs once the accounts below work.
MOCK=1
# stub | real. Keep stub until the TEE (Shade Agent) attestation is working.
ATTESTATION=stub
NEAR_NETWORK=testnet

# 1. The contract account: holds the funds and the taint contract. Needs a FULL-ACCESS key (it deploys the contract).
TAINT_CONTRACT=
TAINT_CONTRACT_PRIVATE_KEY=

# 2. The mock DEX account (testnet-only stand-in for swaps). Needs a FULL-ACCESS key.
MOCKDEX_CONTRACT=
MOCKDEX_PRIVATE_KEY=

# 3. The owner: approves held payments. Demo only; use a throwaway account, not your real wallet.
OWNER_ACCOUNT=
OWNER_PRIVATE_KEY=

# 4. The worker: the agent's account. A function-call key limited to the contract is safest; a full-access key works for now.
WORKER_ACCOUNT=
WORKER_PRIVATE_KEY=

# 5. The relayer: pays the gas for the owner's one-tap approvals. Needs a FULL-ACCESS key.
RELAYER_ACCOUNT=
RELAYER_PRIVATE_KEY=

# The live model (any OpenAI-compatible endpoint, for example NEAR AI Cloud). Needed only for the live runs.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
