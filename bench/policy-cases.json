    {
      "name": "a co-signed payment does not use up the address-book cap",
      "steps": [
        {
          "op": "remember",
          "address": "vendor.near",
          "capNear": "1"
        },
        {
          "op": "propose",
          "id": "held",
          "action": {
            "kind": "Transfer",
            "recipient": "vendor.near",
            "amountNear": "2"
          },
          "prov": {
