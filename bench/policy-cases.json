            "amount": "owner"
          },
          "expect": {
            "Rejected": "malformed"
          }
        }
      ]
    },
    {
      "name": "a swap whose token has no provenance is malformed, not trusted",
      "steps": [
        {
          "op": "propose",
          "id": "a",
          "action": {
            "kind": "Swap",
            "token": "newtoken.near",
            "amountNear": "1"
          },
          "prov": {
            "amount": "owner"
          },
          "expect": {
            "Rejected": "malformed"
          }
        }
      ]
    },
    {
      "name": "provenance for an argument the action does not have is malformed",
      "steps": [
        {
          "op": "propose",
          "id": "a",
          "action": {
            "kind": "Transfer",
            "recipient": "alice.near",
            "amountNear": "1"
          },
          "prov": {
            "recipient": "owner",
            "token": "owner",
            "amount": "owner"
          },
          "expect": {
            "Rejected": "malformed"
          }
        }
      ]
    },
    {
      "name": "unpinning a vouching account revokes its payees",
      "steps": [
        {
          "op": "pin",
          "account": "acme.near"
        },
        {
          "op": "registerPayee",
          "by": "acme.near",
          "address": "pay.near"
        },
        {
          "op": "unpin",
          "account": "acme.near"
        },
        {
          "op": "propose",
          "id": "a",
          "action": {
            "kind": "Transfer",
            "recipient": "pay.near",
            "amountNear": "0.1"
          },
          "prov": {
            "recipient": "email",
            "amount": "owner"
          },
          "expect": {
            "Pending": [
              "recipient from email"
            ]
          }
        }
      ]
    },
    {
      "name": "an address-book cap is cumulative over 24h for what the cap itself allowed",
      "steps": [
        {
          "op": "remember",
          "address": "vendor.near",
          "capNear": "1"
        },
        {
          "op": "propose",
          "id": "a",
          "action": {
            "kind": "Transfer",
            "recipient": "vendor.near",
            "amountNear": "0.6"
          },
          "prov": {
            "recipient": "web",
            "amount": "owner"
          },
          "expect": {
            "Executed": true
          }
        },
        {
          "op": "propose",
          "id": "b",
          "action": {
            "kind": "Transfer",
            "recipient": "vendor.near",
            "amountNear": "0.4"
          },
          "prov": {
            "recipient": "web",
            "amount": "owner"
          },
          "expect": {
            "Executed": true
          }
        },
        {
          "op": "propose",
          "id": "c",
          "action": {
            "kind": "Transfer",
            "recipient": "vendor.near",
            "amountNear": "0.1"
          },
          "prov": {
            "recipient": "web",
            "amount": "owner"
          },
          "expect": {
            "Pending": [
              "amount above entry cap"
            ]
          }
        },
        {
          "op": "advance",
          "ms": 86400000
        },
        {
          "op": "propose",
          "id": "d",
          "action": {
            "kind": "Transfer",
            "recipient": "vendor.near",
            "amountNear": "0.6"
          },
          "prov": {
            "recipient": "web",
            "amount": "owner"
          },
          "expect": {
            "Executed": true
          }
        }
      ]
    },
    {
      "name": "an untrusted amount past the remaining cumulative cap is held for co-sign",
      "steps": [
        {
          "op": "remember",
          "address": "vendor.near",
          "capNear": "1"
        },
        {
          "op": "propose",
          "id": "a",
          "action": {
            "kind": "Transfer",
            "recipient": "vendor.near",
            "amountNear": "0.6"
          },
          "prov": {
            "recipient": "web",
            "amount": "web"
          },
          "expect": {
            "Executed": true
