        {
          "op": "propose",
          "id": "b",
          "action": {
            "kind": "Transfer",
            "recipient": "vendor.near",
            "amountNear": "0.6"
          },
          "prov": {
            "recipient": "web",
            "amount": "web"
          },
          "expect": {
            "Pending": [
              "amount from web"
            ]
          }
